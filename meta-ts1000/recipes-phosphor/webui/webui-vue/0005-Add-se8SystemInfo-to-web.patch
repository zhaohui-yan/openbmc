index 0000000..afa6238
--- /dev/null
+++ b/src/views/HardwareStatus/Inventory/InventoryTablePower.vue
@@ -0,0 +1,89 @@
+<template>
+  <page-section :section-title="$t('pageInventory.powerSupplies')">
+    <b-table
+      responsive="md"
+      hover
+      show-empty
+      :items="powerData"
+      :fields="fields"
+      :empty-text="$t('global.table.emptyMessage')"
+      :busy="isBusy"
+    >
+      <!-- 状态列 -->
+      <template #cell(health)="{ value }">
+        <status-icon :status="statusIcon(value)" />
+        {{ value }}
+      </template>
+    </b-table>
+  </page-section>
+</template>
+
+<script>
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import PageSection from '@/components/Global/PageSection';
+import StatusIcon from '@/components/Global/StatusIcon';
+import api from '@/store/api';
+import DataFormatterMixin from '@/components/Mixins/DataFormatterMixin';
+
+export default {
+  name: 'PowerStatus',
+  components: { PageSection, StatusIcon },
+  mixins: [BVToastMixin, DataFormatterMixin],
+  data() {
+    return {
+      isBusy: true,
+      powerData: [],
+      fields: [
+        {
+          key: 'id',
+          label: this.$t('pagePowerStatus.powerId'),
+          formatter: this.dataFormatter,
+        },
+        {
+          key: 'health',
+          label: this.$t('pagePowerStatus.health'),
+          formatter: this.dataFormatter,
+          tdClass: 'text-nowrap',
+        },
+      ],
+    };
+  },
+  created() {
+    this.fetchPowerData();
+  },
+  methods: {
+    async fetchPowerData() {
+      this.isBusy = true;
+      try {
+        const response = await api.get(
+          '/redfish/v1/Systems/system/se8SystemInfo',
+        );
+        const data = response.data;
+
+        // 构造电源数据（单条记录）
+        this.powerData = [
+          {
+            id: 'power',
+            health: data.PowerSupplyHealth,
+          },
+        ];
+      } catch (error) {
+        console.error('获取电源数据失败:', error);
+        this.errorToast(this.$t('pagePowerStatus.fetchError'));
+      } finally {
+        this.isBusy = false;
+      }
+    },
+
+    // 健康状态图标映射
+    statusIcon(status) {
+      const statusIcons = {
+        OK: 'success',
+        Warning: 'warning',
+        Critical: 'danger',
+      };
+      return statusIcons[status] || 'secondary';
+    },
+  },
+};
+</script>
