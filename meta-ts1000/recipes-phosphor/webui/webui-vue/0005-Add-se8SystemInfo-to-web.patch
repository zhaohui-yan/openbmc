+      :items="storageItems"
+      :fields="storageFields"
+      :empty-text="$t('global.table.emptyMessage')"
+      :busy="isBusy"
+    >
+      <!-- Health状态 -->
+      <template #cell(health)="{ value }">
+        <status-icon :status="statusIcon(value)" />
+        {{ value }}
+      </template>
+
+      <!-- 使用率 -->
+      <template #cell(usagePercent)="{ value }">
+        <div class="d-flex align-items-center">
+          <b-progress
+            :value="value"
+            :max="100"
+            :variant="usageVariant(value)"
+            height="1.5rem"
+            class="flex-grow-1"
+          />
+          <span class="ms-2" :class="{ 'text-danger': value < 5 }">
+            {{ value }}%
+          </span>
+        </div>
+      </template>
+    </b-table>
+  </page-section>
+</template>
+
+<script>
+import PageSection from '@/components/Global/PageSection';
+import StatusIcon from '@/components/Global/StatusIcon';
+import api from '@/store/api';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import DataFormatterMixin from '@/components/Mixins/DataFormatterMixin';
+
+export default {
+  components: { PageSection, StatusIcon },
+  mixins: [BVToastMixin, DataFormatterMixin],
+  data() {
+    return {
+      isBusy: true,
+      storageData: null,
+      storageFields: [
+        {
+          key: 'health',
+          label: this.$t('pageInventory.health'),
+          tdClass: 'text-nowrap',
+        },
+        {
+          key: 'totalCapacity',
+          label: this.$t('pageInventory.totalCapacity'),
+          formatter: (value) => `${value} ${this.$t('unit.GiB')}`,
+        },
+        {
+          key: 'usagePercent',
+          label: this.$t('pageInventory.usagePercent'),
+        },
+      ],
+    };
+  },
+  computed: {
+    storageItems() {
+      if (!this.storageData) return [];
+      return [
+        {
+          health: this.storageData.StorageHealth,
+          totalCapacity: this.storageData.StorageTotalGB,
+          usagePercent: this.storageData.StorageUsagePercent,
+        },
+      ];
+    },
+  },
+  created() {
+    this.fetchStorageData();
+  },
+  methods: {
+    async fetchStorageData() {
+      this.isBusy = true;
+      try {
+        const response = await api.get(
+          '/redfish/v1/Systems/system/se8SystemInfo',
+        );
+        this.storageData = response.data;
+      } catch (error) {
+        console.error('获取存储数据失败:', error);
+        this.errorToast(this.$t('pageInventory.storage.fetchError'));
+      } finally {
+        this.isBusy = false;
+      }
+    },
+    statusIcon(status) {
+      const statusMap = {
+        OK: 'success',
+        Warning: 'warning',
+        Critical: 'danger',
+      };
+      return statusMap[status] || '';
+    },
+    usageVariant(percent) {
+      if (percent >= 90) return 'danger';
+      if (percent >= 70) return 'warning';
+      return 'success';
+    },
+  },
+};
+</script>
