@@ -0,0 +1,128 @@
+<template>
+  <b-modal
+    :id="modalId"
+    ref="modal"
+    :title="modalTitle"
+    @hidden="resetModal"
+    @ok="handleOk"
+  >
+    <b-form @submit.prevent="handleSubmit">
+      <b-form-group
+        :label="$t('pageSnmpCommunity.modal.communityName')"
+        label-for="community-name"
+      >
+        <b-form-input
+          id="community-name"
+          v-model="form.name"
+          :state="nameState"
+        />
+        <b-form-invalid-feedback>
+          {{ $t('pageSnmpCommunity.modal.nameRequired') }}
+        </b-form-invalid-feedback>
+      </b-form-group>
+
+      <b-form-group
+        :label="$t('pageSnmpCommunity.modal.permissionView')"
+        label-for="permission-view"
+      >
+        <b-form-select
+          id="permission-view"
+          v-model="form.permissionView"
+          :options="permissionOptions"
+          :state="permissionState"
+        />
+        <b-form-invalid-feedback>
+          {{ $t('pageSnmpCommunity.modal.permissionRequired') }}
+        </b-form-invalid-feedback>
+      </b-form-group>
+    </b-form>
+  </b-modal>
+</template>
+
+<script>
+export default {
+  name: 'ModalEditCommunity',
+  props: {
+    community: {
+      type: Object,
+      default: null,
+    },
+    permissionOptions: {
+      type: Array,
+      default: () => [],
+    },
+  },
+  data() {
+    return {
+      modalId: 'edit-community-modal',
+      form: {
+        name: '',
+        permissionView: null,
+      },
+    };
+  },
+  computed: {
+    modalTitle() {
+      return this.community
+        ? this.$t('pageSnmpCommunity.modal.editTitle')
+        : this.$t('pageSnmpCommunity.modal.addTitle');
+    },
+    isEdit() {
+      return !!this.community;
+    },
+    nameState() {
+      return this.form.name.length > 0 ? true : false;
+    },
+    permissionState() {
+      return this.form.permissionView ? true : false;
+    },
+  },
+  watch: {
+    community: {
+      immediate: true,
+      handler(newVal) {
+        if (newVal) {
+          this.form.name = newVal.name;
+          this.form.permissionView = newVal.permissionView;
+        }
+      },
+    },
+  },
+  methods: {
+    show() {
+      this.$refs.modal.show();
+    },
+    resetModal() {
+      this.form = {
+        name: '',
+        permissionView: null,
+      };
+    },
+    handleOk(bvModalEvt) {
+      bvModalEvt.preventDefault();
+      this.handleSubmit();
+    },
+    handleSubmit() {
+      if (!this.validateForm()) return;
+
+      this.$emit('save', {
+        isEdit: this.isEdit,
+        community: {
+          ...this.form,
+          originalName: this.community?.originalName || this.community?.name,
+          originalPermissionView:
+            this.community?.originalPermissionView ||
+            this.community?.permissionView,
+        },
+      });
+
+      this.$nextTick(() => {
+        this.$refs.modal.hide();
+      });
+    },
+    validateForm() {
+      return this.nameState && this.permissionState;
+    },
+  },
+};
+</script>
