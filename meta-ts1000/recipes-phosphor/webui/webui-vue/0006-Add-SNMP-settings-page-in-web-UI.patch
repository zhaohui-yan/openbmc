diff --git a/src/views/Settings/Community/Community.vue b/src/views/Settings/Community/Community.vue
new file mode 100644
index 0000000..2b60b7e
--- /dev/null
+++ b/src/views/Settings/Community/Community.vue
@@ -0,0 +1,332 @@
+<template>
+  <b-container fluid="xl">
+    <page-title :description="$t('pageSnmpCommunity.pageDescription')" />
+    <b-row>
+      <b-col xl="9" class="text-right">
+        <b-button variant="primary" @click="showAddModal">
+          <icon-add />
+          {{ $t('pageSnmpCommunity.addCommunity') }}
+        </b-button>
+      </b-col>
+    </b-row>
+    <b-row>
+      <b-col xl="9">
+        <b-table
+          ref="table"
+          responsive="md"
+          show-empty
+          hover
+          :busy="isLoading"
+          :fields="fields"
+          :items="tableItems"
+          :empty-text="$t('global.table.emptyMessage')"
+        >
+          <!-- Name column -->
+          <template #cell(name)="row">
+            {{ row.item.name }}
+          </template>
+
+          <!-- Permission View column -->
+          <template #cell(permissionView)="row">
+            {{ row.item.permissionView }}
+          </template>
+
+          <!-- Table actions column -->
+          <template #cell(actions)="{ item }">
+            <table-row-action
+              v-for="(action, index) in item.actions"
+              :key="index"
+              :value="action.value"
+              :enabled="action.enabled"
+              :title="action.title"
+              :data-test-id="`snmpCommunity-button-${action.value}-${item.index}`"
+              @click-table-action="onTableRowAction($event, item)"
+            >
+              <template #icon>
+                <icon-edit v-if="action.value === 'edit'" />
+                <icon-trashcan v-if="action.value === 'delete'" />
+              </template>
+            </table-row-action>
+          </template>
+
+          <!-- Loading state -->
+          <template #table-busy>
+            <div class="text-center my-2">
+              <b-spinner class="align-middle" />
+              <strong>{{ $t('pageSnmpCommunity.loading') }}</strong>
+            </div>
+          </template>
+        </b-table>
+        <div class="table-action-button">
+          <b-button
+            variant="success"
+            :disabled="isApplying"
+            @click="applyChanges"
+          >
+            <b-spinner v-if="isApplying" small class="mr-2"></b-spinner>
+            {{ $t('pageSnmpCommunity.applyChanges') }}
+          </b-button>
+        </div>
+      </b-col>
+    </b-row>
+
+    <!-- Add/Edit Modal -->
+    <modal-edit-community
+      ref="editModal"
+      :community="selectedCommunity"
+      :permission-options="permissionOptions"
+      @save="handleSave"
+    />
+  </b-container>
+</template>
+
+<script>
+import api from '@/store/api';
+import IconAdd from '@carbon/icons-vue/es/add--alt/20';
+import IconEdit from '@carbon/icons-vue/es/edit/20';
+import IconTrashcan from '@carbon/icons-vue/es/trash-can/20';
+import ModalEditCommunity from './ModalEditCommunity';
+import PageTitle from '@/components/Global/PageTitle';
+import TableRowAction from '@/components/Global/TableRowAction';
+import LoadingBarMixin from '@/components/Mixins/LoadingBarMixin';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+
+export default {
+  name: 'Community',
+  components: {
+    PageTitle,
+    IconAdd,
+    IconEdit,
+    IconTrashcan,
+    ModalEditCommunity,
+    TableRowAction,
+  },
+  mixins: [BVToastMixin, LoadingBarMixin],
+  beforeRouteLeave(to, from, next) {
+    this.hideLoader();
+    next();
+  },
+  data() {
+    return {
+      isLoading: false,
+      communities: [],
+      permissionOptions: [], // 存储权限视图选项
+      selectedCommunity: null,
+      isApplying: false,
+      fields: [
+        {
+          key: 'name',
+          label: this.$t('pageSnmpCommunity.table.name'),
+        },
+        {
+          key: 'permissionView',
+          label: this.$t('pageSnmpCommunity.table.permissionView'),
+        },
+        {
+          key: 'actions',
+          label: '',
+          tdClass: 'text-right text-nowrap',
+        },
+      ],
+    };
+  },
+  computed: {
+    tableItems() {
+      return this.communities.map((community) => {
+        return {
+          ...community,
+          id: community.name,
+          actions: [
+            {
+              value: 'edit',
+              enabled: true,
+              title: this.$t('pageSnmpCommunity.edit'),
+            },
+            {
+              value: 'delete',
+              enabled: true,
+              title: this.$t('pageSnmpCommunity.delete'),
+            },
+          ],
+        };
+      });
+    },
+  },
+  created() {
+    this.startLoader();
+    this.fetchPermissionOptions(); // 先获取权限选项
+    this.fetchCommunities();
+  },
+  methods: {
+    async applyChanges() {
+      this.isApplying = true;
+      try {
+        const response = await api.post(
+          '/redfish/v1/Systems/system/snmp/community/apply',
+          {},
+        );
+
+        if (response.data.code === 0) {
+          this.successToast(this.$t('pageSnmpCommunity.toast.applySuccess'));
+        } else {
+          this.errorToast(
+            this.$t('pageSnmpCommunity.toast.applyError', {
+              message: response.data.message,
+            }),
+          );
+        }
+      } catch (error) {
+        console.error('SNMP apply changes error:', error);
+        this.errorToast(
+          this.$t('pageSnmpCommunity.toast.applyError', {
+            message: error.message || 'Unknown error',
+          }),
+        );
+      } finally {
+        this.isApplying = false;
+      }
+    },
+    async fetchPermissionOptions() {
+      try {
+        const response = await api.get(
+          '/redfish/v1/Systems/system/snmp/community/PermissionOID',
+        );
+        this.permissionOptions = response.data.permissionViews || [];
+      } catch (error) {
+        console.error('Failed to fetch permission options:', error);
+        this.permissionOptions = [];
+      }
+    },
+    async fetchCommunities() {
+      this.isLoading = true;
+      try {
+        const response = await api.get(
+          '/redfish/v1/Systems/system/snmp/community/entries',
+        );
+        const items = response.data?.res?.filter((item) => item !== null) || [];
+
+        this.communities = items.map((item) => ({
+          ...item,
+          name: item.name || this.$t('pageSnmpCommunity.unnamedCommunity'),
+          permissionView:
+            item.permissionView || this.$t('pageSnmpCommunity.noPermission'),
+        }));
+      } catch (error) {
+        console.error('SNMP communities fetch error:', error);
+        this.errorToast(this.$t('pageSnmpCommunity.toast.fetchError'));
+      } finally {
+        this.isLoading = false;
+        this.endLoader();
+      }
+    },
+    showAddModal() {
+      this.selectedCommunity = null;
+      this.$refs.editModal.show();
+    },
+    async handleSave({ isEdit, community }) {
+      const action = isEdit ? 'modify' : 'add';
+      const endpoint = `/redfish/v1/Systems/system/snmp/community/${action}`;
+
+      const payload = isEdit
+        ? {
+            oldname: community.originalName,
+            oldPermissionView: community.originalPermissionView,
+            name: community.name,
+            permissionView: community.permissionView,
+          }
+        : {
+            name: community.name,
+            permissionView: community.permissionView,
+          };
+
+      this.startLoader();
+      try {
+        const response = await api.post(endpoint, payload);
+        if (response.data.code === 0) {
+          this.successToast(
+            isEdit
+              ? this.$t('pageSnmpCommunity.toast.editSuccess')
+              : this.$t('pageSnmpCommunity.toast.addSuccess'),
+          );
+          this.fetchCommunities();
+        } else {
+          throw new Error(response.data.message);
+        }
+      } catch (error) {
+        console.error('SNMP community save error:', error);
+        this.errorToast(
+          isEdit
+            ? this.$t('pageSnmpCommunity.toast.editError')
+            : this.$t('pageSnmpCommunity.toast.addError'),
+        );
+      } finally {
+        this.endLoader();
+        this.fetchCommunities();
+      }
+    },
+    initModalDeleteCommunity(community) {
+      this.$bvModal
+        .msgBoxConfirm(
+          this.$t('pageSnmpCommunity.deleteConfirmMessage', {
+            name: community.name,
+          }),
+          {
+            title: this.$t('pageSnmpCommunity.deleteConfirmTitle'),
+            okTitle: this.$t('pageSnmpCommunity.delete'),
+            cancelTitle: this.$t('global.action.cancel'),
+            autoFocusButton: 'ok',
+          },
+        )
+        .then((deleteConfirmed) => {
+          if (deleteConfirmed) {
+            this.deleteCommunity(community);
+          }
+        });
+    },
+    async deleteCommunity(community) {
+      this.startLoader();
+      try {
+        const response = await api.post(
+          '/redfish/v1/Systems/system/snmp/community/delete',
+          {
+            name: community.name,
+          },
+        );
+
+        if (response.data.code === 0) {
+          this.successToast(this.$t('pageSnmpCommunity.toast.deleteSuccess'));
+          this.fetchCommunities();
+        } else {
+          throw new Error(response.data.message);
+        }
+      } catch (error) {
+        console.error('SNMP community delete error:', error);
+        // this.errorToast(this.$t('pageSnmpCommunity.toast.deleteError'));
+      } finally {
+        this.endLoader();
+        this.fetchCommunities();
+      }
+    },
+    onTableRowAction(action, item) {
+      if (action === 'edit') {
+        this.selectedCommunity = {
+          ...item,
+          originalName: item.name,
+          originalPermissionView: item.permissionView,
+        };
+        this.$refs.editModal.show();
+      } else if (action === 'delete') {
+        this.initModalDeleteCommunity(item);
+      }
+    },
+  },
+};
+</script>
+<style scoped>
+.table-action-button {
+  position: absolute;
+  bottom: -50px;
+  right: 50;
+  margin-top: 0px;
+}
+</style>
