+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/system/snmp/community/entries")
+    .privileges({{"Login"}})
+    .methods(boost::beast::http::verb::get)(
+        [](const crow::Request& /* req */,
+           const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+           // 启动异步进程执行SNMP命令
+            boost::process::ipstream pipeStream;
+            boost::process::child commandProcess(
+                "/usr/sbin/snmp_manager.sh", "get",
+                boost::process::std_out > pipeStream,
+                boost::process::std_err > boost::process::null
+            );
+
+            // 读取命令输出
+            std::string output;
+            std::getline(pipeStream, output);
+            commandProcess.wait();
+
+            // 检查命令执行结果
+            if (commandProcess.exit_code() != 0) {
+                messages::internalError(asyncResp->res);
+                return;
+            }
+
+            // std::cout << "output:" << output << std::endl;
+
+            // 清理输出数据 - 移除方括号和空格
+            std::regex entryRegex(R"(\((\w+),\s*([\d\.]+)\))");
+            std::vector<nlohmann::json> entries;
+
+            auto words_begin = std::sregex_iterator(
+                output.begin(), output.end(), entryRegex);
+            auto words_end = std::sregex_iterator();
+
+            for (std::sregex_iterator i = words_begin; i != words_end; ++i) {
+                std::smatch match = *i;
+                // std::cout << "name: " << match[1].str() << " permissionView: " << match[2].str() << std::endl;
+                entries.push_back({
+                    {"name", match[1].str()},
+                    {"permissionView", match[2].str()}
+                });
+            }
+
+            // 构建JSON响应
+            asyncResp->res.jsonValue = {
+                {"code", 0},
+                {"res", std::move(entries)},
+                {"@odata.type", "#SNMPCommunityCollection.SNMPCommunityCollection"},
+                {"@odata.id", "/redfish/v1/Systems/system/snmp/community/entries"},
+                {"Members@odata.count", entries.size()}  // 添加条目计数
+            };
+    });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/system/snmp/community/modify")
+    .privileges({{"Login"}})
+    .methods(boost::beast::http::verb::post)(
+         [](const crow::Request& req,
+           const std::shared_ptr<bmcweb::AsyncResp>& asyncResp) {
+
+            // 解析请求的JSON
+            nlohmann::json jsonData;
+            try {
+                jsonData = nlohmann::json::parse(req.body());
+            } catch (const nlohmann::json::parse_error& e) {
+                // BMCWEB_LOG_ERROR << "JSON parse error: " << e.what();
+                messages::internalError(asyncResp->res);
+                return;
+            }
+
+            // 检查必需的字段
+            if (!jsonData.contains("oldname") ||
+                !jsonData.contains("oldPermissionView") ||
+                !jsonData.contains("name") ||
+                !jsonData.contains("permissionView")) {
+
+                messages::propertyMissing(asyncResp->res, "One or more required properties (oldname, oldPermissionView, name, permissionView)");
+                return;
+            }
+
+            // 提取字段值
+            std::string oldname, oldPermissionView, newname, newPermissionView;
+            oldname = jsonData["oldname"].get<std::string>();
+            oldPermissionView = jsonData["oldPermissionView"].get<std::string>();
+            newname = jsonData["name"].get<std::string>();
+            newPermissionView = jsonData["permissionView"].get<std::string>();
+            // try {
+            //     oldname = jsonData["oldname"].get<std::string>();
+            //     oldPermissionView = jsonData["oldPermissionView"].get<std::string>();
+            //     newname = jsonData["name"].get<std::string>();
+            //     newPermissionView = jsonData["permissionView"].get<std::string>();
+            // } catch (const nlohmann::json::type_error& e) {
+            //     // BMCWEB_LOG_ERROR << "JSON type error: " << e.what();
+            //     messages::propertyValueTypeError(asyncResp->res, e.what());
+            //     return;
+            // }
+
+            // 构建命令
+            std::string command = "/usr/sbin/snmp_manager.sh set " +
+                                  oldname + " " + oldPermissionView + " " +
+                                  newname + " " + newPermissionView;
+
+            // 执行命令
+            int ret = system(command.c_str());
+
+            // 检查命令执行结果
+            if (ret != 0) {
+                // BMCWEB_LOG_ERROR << "Command execution failed: " << command << " returned " << ret;
+                // messages::internalError(asyncResp->res);
+                asyncResp->res.result(boost::beast::http::status::ok);
+                asyncResp->res.jsonValue = {
+                    {"code", 1},
+                    {"message", oldname + " not exist"}
+                };
+                return;
+            }
+
+            // 返回成功响应
+            asyncResp->res.result(boost::beast::http::status::ok);
+            asyncResp->res.jsonValue = {
+                {"code", 0},
+                {"message", "success"}
+            };
+            snmp_conf_flag.fetch_add(1);
+        });
