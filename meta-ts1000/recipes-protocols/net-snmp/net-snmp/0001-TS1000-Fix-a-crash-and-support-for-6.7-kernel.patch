+static int
 _systemstats_v6_load_systemstats(netsnmp_container* container, u_int load_flags)
 {
     FILE *devin;
     netsnmp_systemstats_entry *entry = NULL;
     const char     *filename = "/proc/net/snmp6";
     int rc = 0;
-    
+
     entry = netsnmp_access_systemstats_entry_create(2, 0,
