@@ -664,7 +671,7 @@ _systemstats_v6_load_ifstats(netsnmp_container* container, u_int load_flags)
             }
             scan_val = strtoull(scan_str, NULL, 0);
         }
-        
+
         entry = netsnmp_access_systemstats_entry_create(2, scan_val,
                 "ipIfStatsTable.ipv6");
         if(NULL == entry) {
@@ -672,7 +679,7 @@ _systemstats_v6_load_ifstats(netsnmp_container* container, u_int load_flags)
             closedir(dev_snmp6_dir);
             return -3;
         }
-        
+
         _systemstats_v6_load_file(entry, devin);
         CONTAINER_INSERT(container, entry);
         fclose(devin);
@@ -682,7 +689,7 @@ _systemstats_v6_load_ifstats(netsnmp_container* container, u_int load_flags)
 }
 
 /*
- * Based on load_flags, load ipSystemStatsTable or ipIfStatsTable for ipv6 entries. 
