                 dev_snmp6_entry->d_name) > DEV_FILENAME_LEN) {
             snmp_log(LOG_ERR, "Interface name %s is too long\n",
@@ -634,7 +641,7 @@ _systemstats_v6_load_ifstats(netsnmp_container* container, u_int load_flags)
