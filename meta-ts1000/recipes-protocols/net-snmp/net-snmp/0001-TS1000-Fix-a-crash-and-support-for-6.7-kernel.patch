+
     rc = _systemstats_v6_load_file(entry, devin);
 
     fclose(devin);
@@ -592,7 +599,7 @@ _systemstats_v6_load_systemstats(netsnmp_container* container, u_int load_flags)
 /*
  * load ipIfStatsTable for ipv6 entries
  */
