+static int
 _systemstats_v6_load_file(netsnmp_systemstats_entry *entry, FILE *devin)
 {
     char            line[1024];
@@ -526,7 +533,7 @@ _systemstats_v6_load_file(netsnmp_systemstats_entry *entry, FILE *devin)
                 rc = 1;
         } else
             rc = 1;
